<!--
  Conexiones registradas por la regla iptables LOG de la víctima (prefijo "IPTABLES-SCAN: ").
  Ejemplo de línea:
  kernel: [1234.56] IPTABLES-SCAN: IN=enp0s3 OUT= MAC=... SRC=192.168.56.30 DST=192.168.56.20 LEN=44 ... PROTO=TCP SPT=51234 DPT=22 ...
-->
<decoder name="iptables-scan">
  <program_name>^kernel</program_name>
  <prematch>IPTABLES-SCAN: </prematch>
</decoder>

<decoder name="iptables-scan-fields">
  <parent>iptables-scan</parent>
  <regex>SRC=(\S+) DST=(\S+) \.+ PROTO=(\w+) SPT=(\d+) DPT=(\d+)</regex>
  <order>srcip,dstip,protocol,srcport,dstport</order>
</decoder>
