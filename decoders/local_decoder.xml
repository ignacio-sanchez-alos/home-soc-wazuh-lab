<!--
  Decoders propios · Home SOC Wazuh Lab · Ignacio Sánchez Alós
  Ruta en el manager: /var/ossec/etc/decoders/local_decoder.xml

  Decodifica las conexiones registradas por la regla iptables LOG de la víctima
  (prefijo "IPTABLES-SCAN: "). Ejemplo de línea en kern.log:
    ... kernel: IPTABLES-SCAN: IN=lo OUT= MAC=... SRC=192.168.56.20 DST=192.168.56.20
        LEN=44 ... PROTO=TCP SPT=57651 DPT=78 WINDOW=1024 RES=0x00 SYN URGP=0
-->

<decoder name="iptables-scan">
  <prematch>IPTABLES-SCAN: </prematch>
</decoder>

<decoder name="iptables-scan-fields">
  <parent>iptables-scan</parent>
  <pcre2>SRC=(\S+) DST=(\S+).*?PROTO=(\w+) SPT=(\d+) DPT=(\d+)</pcre2>
  <order>srcip,dstip,protocol,srcport,dstport</order>
</decoder>
